{
  "redirects": [
    { "source": "/bhs", "destination": "https://menus.wearecacho.com/bhs", "statusCode": 301 },
    { "source": "/bhs/:path*", "destination": "https://menus.wearecacho.com/bhs/:path*", "statusCode": 301 },
    { "source": "/admin", "destination": "https://menus.wearecacho.com/admin", "statusCode": 301 },
    { "source": "/admin/:path*", "destination": "https://menus.wearecacho.com/admin/:path*", "statusCode": 301 },
    { "source": "/privacidad", "destination": "https://menus.wearecacho.com/privacidad", "statusCode": 301 }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://cacho-menus.vercel.app/api/:path*" },
    { "source": "/_next/:path*", "destination": "https://cacho-menus.vercel.app/_next/:path*" },
    { "source": "/icon.svg", "destination": "https://cacho-menus.vercel.app/icon.svg" },
    { "source": "/logo-cacho.png", "destination": "https://cacho-menus.vercel.app/logo-cacho.png" },
    { "source": "/images/hero.jpg", "destination": "https://cacho-menus.vercel.app/images/hero.jpg" },
    { "source": "/images/quienes-somos.jpg", "destination": "https://cacho-menus.vercel.app/images/quienes-somos.jpg" },
    { "source": "/images/valores-bg.jpg", "destination": "https://cacho-menus.vercel.app/images/valores-bg.jpg" }
  ]
}
